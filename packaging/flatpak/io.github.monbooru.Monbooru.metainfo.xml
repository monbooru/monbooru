<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.monbooru.Monbooru</id>
  <name>Monbooru</name>
  <summary>Lightweight and fast private booru</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <launchable type="desktop-id">io.github.monbooru.Monbooru.desktop</launchable>

  <description>
    <p>
      A self-hosted, offline image organizer for a local collection: tag-based
      search, folder tree, favorites, collections, near-duplicate detection,
      and a manga reader. The interface runs in a browser tab instead of as a standalone app.
    </p>
    <p>
      Monbooru itself never contacts the internet. Downloading from boorus and
      reverse image lookup live in monloader, a separate optional companion.
    </p>
  </description>

  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>RasterGraphics</category>
    <category>Viewer</category>
  </categories>

  <url type="homepage">https://github.com/monbooru/monbooru</url>
  <url type="bugtracker">https://github.com/monbooru/monbooru/issues</url>
  <url type="help">https://monbooru.github.io/mondocs/index.html</url>

  <screenshots>
    <screenshot type="default">
      <caption>Search results, with the tags of the matching images beside them</caption>
      <image>https://raw.githubusercontent.com/monbooru/monbooru/main/.github/assets/gallery.webp</image>
    </screenshot>
    <screenshot>
      <caption>An image with its tags, sources and metadata</caption>
      <image>https://raw.githubusercontent.com/monbooru/monbooru/main/.github/assets/image.webp</image>
    </screenshot>
    <screenshot>
      <caption>An AI-generated image with its auto-tags and ComfyUI generation data</caption>
      <image>https://raw.githubusercontent.com/monbooru/monbooru/main/.github/assets/sd.webp</image>
    </screenshot>
    <screenshot>
      <caption>The Tags page with categories, usage counts and implications</caption>
      <image>https://raw.githubusercontent.com/monbooru/monbooru/main/.github/assets/tags.webp</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

